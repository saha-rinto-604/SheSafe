{
  "name": "resqher-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start",
    "start:clear": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo run:android",
    "android:check": "powershell -ExecutionPolicy Bypass -File ./scripts/check-android-device.ps1",
    "android:run": "npx expo run:android --device",
    "ios": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo run:ios",
    "web": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --web",
    "lint": "expo lint",
    "postinstall": "node ./scripts/patch-expo-ngrok.js"
  },
  "dependencies": {
