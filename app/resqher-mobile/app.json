{
  "expo": {
    "name": "SheSafe",
    "slug": "resqher-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/SheSafe_logo.png",
    "scheme": "resqhermobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/SheSafe_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "package": "com.anonymous.resqhermobile"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SheSafe needs your location for emergency assistance.",
        "NSLocationAlwaysUsageDescription": "SheSafe needs your location for emergency assistance.",
        "NSCameraUsageDescription": "SheSafe needs camera access to capture verification photos.",
        "NSPhotoLibraryUsageDescription": "SheSafe needs photo access to upload verification documents."
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/SheSafe_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/SheSafe_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SheSafe needs your location for emergency assistance.",
          "locationAlwaysAndWhenInUsePermission": "SheSafe needs your location for emergency assistance."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9231df45-5699-4c65-b52f-77038e544d5f"
      }
    }
  }
}
